# Supabase Configuration
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Reown (WalletConnect) Configuration
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id_here

# Blockchain Configuration (Arc Testnet)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc-testnet.arc.xyz
NEXT_PUBLIC_CHAIN_ID=412346
NEXT_PUBLIC_USDC_ADDRESS=0x75faf114eAfb1BDbe2F0316DF893fd58CE46AA4d
NEXT_PUBLIC_ESCROW_ADDRESS=0xe644d74eD42b5662d89eaC529D1D49D519F23Ba8
NEXT_PUBLIC_ESCROW_NATIVE_ADDRESS=0xcAD96aB804F55467342eCEDD555Bf17c198E3513
NEXT_PUBLIC_STAKING_POOL_ADDRESS=0x8780F1Dfae460A0B5C541e7F619B37e3A0bd09D5
NEXT_PUBLIC_STAKING_POOL_NATIVE_ADDRESS=0xcAc6F7b0d2Bf641c00F7426b4bAF1CAFaE96d4dc
NEXT_PUBLIC_REPUTATION_ADDRESS=0x1DAeE5dBb25758FBe34f5366e17021D2e12Cb8Fa
NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS=0x7778b915e86fBf35d9E1cB7fD5d3fD8A6c0bEBFB

# ============================================================================
# ⚠️ SERVER-ONLY SECRETS (CRITICAL SECURITY)
# ============================================================================
# These variables should NEVER have NEXT_PUBLIC_ prefix
# They are only accessible in server-side code (API routes, server actions)
# ⚠️ NEVER commit real private keys to git

# Server-side private key for automated operations
# Used for: deployment, contract interactions, job cancellation, etc.
# Generate a new wallet for this purpose - DO NOT use your personal wallet
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Server RPC URL (optional - can use same as public or premium endpoint)
RPC_URL=https://rpc-testnet.arc.xyz

# CSRF Secret (generate with: openssl rand -hex 32)
CSRF_SECRET=your_csrf_secret_here_generate_with_openssl

# ============================================================================
# OPTIONAL - Production Features
# ============================================================================

# Sentry Error Tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Redis for Production Rate Limiting (optional)
# REDIS_URL=redis://localhost:6379

# App URL for CORS (optional)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ============================================================================
# ❌ REMOVED FOR SECURITY
# ============================================================================
# NEXT_PUBLIC_DEV_PRIVATE_KEY - This was exposing private keys to client
# Use DEPLOYER_PRIVATE_KEY instead (server-only, no NEXT_PUBLIC_ prefix)

